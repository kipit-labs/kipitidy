{
  "name": "@kipit-labs/kipitidy",
  "version": "0.3.0",
  "description": "kipit-labs UI kit: compact shadcn-based React components and their Tailwind v4 theme.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kipit-labs/kipitidy.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "files": [
    "dist",
    "theme.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build",
    "design:build": "node .design-sync/build-pkg.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
